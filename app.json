{
  "expo": {
    "name": "채움원",
    "slug": "thefull-m",
    "scheme": "thefullm",
    "version": "1.1",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "출퇴근 기록을 위해 현재 위치 권한이 필요합니다.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "위생점검 사진을 촬영하기 위해 카메라 권한이 필요합니다.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withPlayServicesAppSet.js",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thefull.thefullm",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.thefull.thefullm",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2cb4243-7c4d-47f9-9300-98664716ac2f"
      }
    }
  }
}
